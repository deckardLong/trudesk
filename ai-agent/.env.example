# ---- AI Agent Service ----
PORT=8200
# Phải trùng AI_AGENT_WEBHOOK_SECRET bên Trudesk Core
AI_WEBHOOK_SECRET=change-me

# mock = offline | ollama = model local (khuyến nghị, dữ liệu không ra khỏi máy) | claude = Claude API
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# 4096 đủ cho prompt; 8192 làm tràn VRAM 4 GB (RTX 2070) -> chậm ~20 lần
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=1024
OLLAMA_TIMEOUT_MS=180000
AI_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=sk-ant-...

# Tự động trả lời người dùng (ai-agent/src/autoreply/policy.js)
AI_AUTO_REPLY=true
AI_AUTO_REPLY_TYPES=Incident
AI_AUTO_REPLY_BLOCKED_PRIORITIES=Critical
AI_AUTO_REPLY_MIN_CONFIDENCE=0.7
AI_AUTO_REPLY_MIN_GROUNDING=0.3
AI_AUTO_REPLY_ACK=true
AI_AUTO_REPLY_PENDING_STATUS=Pending
AI_AUTO_REPLY_OPEN_STATUS=Open
AI_AUTO_REPLY_CLOSED_STATUS=Closed

# Guardrails (sơ đồ 5, 6)
AI_CONFIDENCE_THRESHOLD=0.7
AI_AUTO_APPLY=false
AI_AUTO_APPLY_THRESHOLD=0.95
AI_SUGGESTION_TTL_MS=21600000
AI_MAX_CALLS_PER_HOUR=300
AI_MAX_TOKENS_PER_DAY=2000000

# Kết nối Core: mock = Core giả trong bộ nhớ | http = Trudesk thật
CORE_MODE=mock
TRUDESK_URL=http://localhost:8118
# Access token của tài khoản dịch vụ AI (role support, chỉ cần quyền xem ticket + ghi note)
TRUDESK_AI_TOKEN=
# endpoint = khu "Gợi ý từ AI" trong ticket (mặc định) | internal-note = ghi thành ghi chú nội bộ
AI_SUGGESTION_SINK=endpoint

# Đường dẫn tính từ thư mục chạy lệnh (gốc repo khi dùng `npm run ai-agent`)
AI_AUDIT_LOG=logs/ai-audit.jsonl

# ---- Bên Trudesk Core (đặt trong môi trường chạy Trudesk) ----
# AI_AGENT_WEBHOOK_URL=http://localhost:8200/events
# AI_AGENT_WEBHOOK_SECRET=change-me
# TICKET_REPLY_NOTIFY=v2            # legacy = quay về thông báo cũ
# TICKET_NOTIFY_MAIL_MODE=smtp      # mock = ghi .eml vào logs/mock-mailbox thay vì gửi thật
# TICKET_NOTIFY_DEBOUNCE_MS=60000
# TICKET_REPLY_SECRET=...           # mặc định dùng tokens:secret trong config.yml
# TICKET_REPLY_MAILBOX=support@acme.vn
# AI_BOT_USERNAME=ai.assistant      # tài khoản dịch vụ của AI (role support); TRUDESK_AI_TOKEN là token của tài khoản này
